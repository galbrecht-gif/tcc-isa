NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Segredos (obrigatorios em producao)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
SESSION_SECRET=troque-por-outro-segredo-longo-e-aleatorio

# Modo demo: botoes de atalho no login e e-mails expostos em /api/demo/emails.
# Ignorado automaticamente quando NODE_ENV=production.
DEMO_MODE=true

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Para cadastrar o primeiro gestor em um banco vazio, use temporariamente no ambiente do comando:
# GESTOR_NOME=
# GESTOR_EMAIL=
# GESTOR_SENHA_TEMPORARIA=

# Para definir a senha temporaria padrao das contas de equipe:
# EQUIPE_SENHA_TEMPORARIA=

# Banco de dados (sqlite local por padrao)
DB_CLIENT=better-sqlite3
# PostgreSQL (recomendado em producao; configure DATABASE_URL no ambiente do servidor)
# DB_CLIENT=pg
# DATABASE_URL=
# DB_SSL=false
# DB_FILENAME=./database/dev.sqlite
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# SMTP (obrigatório para enviar códigos de recuperação de senha e outros e-mails)
# Outros e-mails podem usar o fallback de demonstração em desenvolvimento se estiver vazio.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SENAI Controle de Frequencia <no-reply@senai.local>"

TZ_APP=America/Sao_Paulo
